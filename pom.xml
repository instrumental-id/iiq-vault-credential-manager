<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.instrumentalid.iiq.vault</groupId>
    <artifactId>vault-credential-manager</artifactId>
    <version>1.0-SNAPSHOT</version>

    <name>vault-credential-manager</name>
    <url>https://www.instrumentalidentity.com</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>

        <vault.url>NOT_SET</vault.url>
        <vault.token>NOT_SET</vault.token>
        <vault.path>NOT_SET</vault.path>
        <vault.engine.version>2</vault.engine.version>

        <!-- Dynamic properties for optional parameters -->
        <vault.key.param/>
        <vault.ssl.param/>
        <vault.server.cert.param/>
        <vault.server.cert.path/>

        <vault.client.key.param/>
        <vault.client.key.path/>

        <version.log4j>2.25.3</version.log4j>
        <version.vault-driver>6.2.3</version.vault-driver>
        <version.junit5>5.14.1</version.junit5>
        <version.maven-surefire>3.5.2</version.maven-surefire>
    </properties>

    <dependencies>
        <dependency>
            <groupId>sailpoint</groupId>
            <artifactId>identityiq</artifactId>
            <version>8.4.2</version>
            <scope>system</scope>
            <systemPath>${pom.basedir}/lib/sailpoint/identityiq.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>sailpoint</groupId>
            <artifactId>pam-credential</artifactId>
            <version>8.4.2</version>
            <scope>system</scope>
            <systemPath>${pom.basedir}/lib/sailpoint/pam-credential.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>io.github.jopenlibs</groupId>
            <artifactId>vault-java-driver</artifactId>
            <version>${version.vault-driver}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.20.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>commons-logging</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.3.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.42</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
            <version>4.7.6</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${version.log4j}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>${version.log4j}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-jcl</artifactId>
            <version>${version.log4j}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjrt</artifactId>
            <version>1.9.23</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${version.junit5}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${version.junit5}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${version.junit5}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>1.18.42</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${version.maven-surefire}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/*IntegrationTest.java</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.maven-surefire}</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>com.instrumentalid.iiq.vault.IntegrationTest</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <!-- Properties are injected by the CLI, don't worry about them being missing here -->
                                <argument>--url</argument>
                                <argument>${vault.url}</argument>
                                <argument>--token</argument>
                                <argument>${vault.token}</argument>
                                <argument>--path</argument>
                                <argument>${vault.path}</argument>
                                <argument>--engine-version</argument>
                                <argument>${vault.engine.version}</argument>
                                <argument>${vault.key.param}</argument>
                                <!--suppress UnresolvedMavenProperty -->
                                <argument>${vault.key.value}</argument>
                                <argument>${vault.ssl.param}</argument>
                                <!--suppress UnresolvedMavenProperty -->
                                <argument>${vault.ssl.value}</argument>
                                <argument>${vault.server.cert.param}</argument>
                                <argument>${vault.server.cert.path}</argument>
                                <argument>${vault.client.key.param}</argument>
                                <argument>${vault.client.key.path}</argument>
                            </arguments>
                            <cleanupDaemonThreads>false</cleanupDaemonThreads>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>with-key</id>
            <properties>
                <vault.key.param>--key</vault.key.param>
                <vault.key.value/>
            </properties>
        </profile>
        <profile>
            <id>with-ssl-verify</id>
            <properties>
                <vault.ssl.param>--ssl-verify</vault.ssl.param>
                <vault.ssl.value>false</vault.ssl.value>
            </properties>
        </profile>
        <profile>
            <id>with-server-cert</id>
            <properties>
                <vault.server.cert.param>--server-cert</vault.server.cert.param>
                <vault.server.cert.path/>
            </properties>
        </profile>
        <profile>
            <id>with-client-key</id>
            <properties>
                <vault.client.key.param>--client-key</vault.client.key.param>
                <vault.client.key.path/>
            </properties>
        </profile>
    </profiles>

</project>
