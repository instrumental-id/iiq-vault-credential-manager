<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE Configuration PUBLIC "sailpoint.dtd" "sailpoint.dtd">
<Configuration name="CredentialConfiguration">
    <Attributes>
        <Map>
            <entry key="sources">
                <value>
                    <List>
                        <CredentialSource credentialClass="com.instrumentalid.iiq.vault.VaultCredentialManager" name="vaultCredManager">
                            <Attributes>
                                <Map>
                                    <entry key="authType" value="appRole"/>
                                    <entry key="clientKeyPemFile"/>
                                    <entry key="clientKeyPemUTF8"/>
                                    <entry key="roleId" value="7f6c7b75..."/>
                                    <entry key="secretId" value="b0aa3fa6..."/>
                                    <entry key="serverCertPemFile"/>
                                    <entry key="serverCertPemUTF8"/>
                                    <entry key="sslVerify" value="true"/>
                                    <entry key="url" value="https://your.vault.server:8200"/>
                                </Map>
                            </Attributes>
                            <CredentialAssociation applicationName="Test" attributeName="password" credentialAttributeName="database/static-creds/some_role_name">
                                <Attributes>
                                    <Map>
                                        <!-- For 'database' secrets, the version is likely to be 1 -->
                                        <!-- For 'kv' secrets, the version depends on your kv setup -->
                                        <entry key="engineVersion" value="1"/>

                                        <!-- This is the value to extract from the Vault response 'data' section -->
                                        <entry key="key" value="password"/>
                                    </Map>
                                </Attributes>
                            </CredentialAssociation>
                        </CredentialSource>
                    </List>
                </value>
            </entry>
        </Map>
    </Attributes>
</Configuration>
